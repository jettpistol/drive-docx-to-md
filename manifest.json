{
  "manifest_version": 3,
  "name": "Drive Folder to Markdown",
  "version": "1.0.0",
  "description": "Download every document in a Google Drive folder as Markdown (.md), keeping the folder structure.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "Export this Drive folder as Markdown",
    "default_popup": "src/popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png" }
  },
  "permissions": ["identity", "activeTab", "downloads", "storage"],
  "host_permissions": ["https://www.googleapis.com/*"],
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID.apps.googleusercontent.com",
    "scopes": ["https://www.googleapis.com/auth/drive.readonly"]
  }
}
